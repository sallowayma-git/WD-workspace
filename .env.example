# Non-secret local defaults. Copy to .env and provide secrets out-of-band.
ASSISTANT_API_PORT=8080
ASSISTANT_DB_HOST=127.0.0.1
ASSISTANT_DB_PORT=5432
ASSISTANT_DB_NAME=assistant_workbench
ASSISTANT_DB_USER=assistant_app
# Required for local Compose/API startup; keep the real value only in an untracked .env or process environment.
# ASSISTANT_DB_PASSWORD=
ASSISTANT_BUSINESS_TIMEZONE=Asia/Shanghai
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
# Dev users are created only by the guarded seed-dev flow; production must provision users through an admin/bootstrap process.
ASSISTANT_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost
# Disable the frontend login flow for the local single-machine (Tauri) build.
# Set VITE_AUTH_DISABLED=true in .env.development for dev runs; the backend dev
# profile already permits all requests as the local administrator.
# VITE_AUTH_DISABLED=true
